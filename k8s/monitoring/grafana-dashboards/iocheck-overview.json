{
  "uid": "iocheck-overview",
  "title": "iocheck overview",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate (RPS) by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{namespace=\"iocheck\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p99 latency — /lookup (SLO 200ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/lookup\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU per pod (millicores) — HPA triggers at 140m (70% of 200m request)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 160,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 140 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"iocheck\",container=\"iocheck\"}[1m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Replicas (UP iocheck pods)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"iocheck\"} == 1)",
          "legendFormat": "replicas"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Challenge #1 — CPU % of request vs p99 latency (CPU-HPA is blind to the I/O bottleneck)",
      "description": "A CPU-based HPA fires at 70% of request. Under an I/O-bound (cache-miss) load, CPU hugs the bottom while p99 blows past the 200ms SLO — so a CPU HPA never scales. This panel IS the challenge-#1 evidence.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "axisPlacement": "left", "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 70 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p99 /lookup (s)" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "s" },
              { "id": "custom.thresholdsStyle", "value": { "mode": "off" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU % of request" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg(rate(container_cpu_usage_seconds_total{namespace=\"iocheck\",container=\"iocheck\"}[1m])) / 0.2",
          "legendFormat": "CPU % of request"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/lookup\"}[1m])))",
          "legendFormat": "p99 /lookup (s)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "In-flight requests (concurrency)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_in_flight_requests{namespace=\"iocheck\"})",
          "legendFormat": "in-flight"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Challenge #3 — KEDA concurrency scaling: replicas scale up as load rises → p99 recovers",
      "description": "The M6 payoff (pair with the Challenge #1 panel). Under the same storm, KEDA scales replicas on in-flight concurrency and p99 recovers — the opposite of the CPU-HPA which stayed pinned at 2.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "lineWidth": 2 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p99 /lookup (s)" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "s" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "replicas" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } },
              { "id": "max", "value": 9 }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"iocheck\"} == 1)",
          "legendFormat": "replicas"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/lookup\"}[1m])))",
          "legendFormat": "p99 /lookup (s)"
        }
      ]
    }
  ]
}
