# ---- iocheck configuration (copy to .env and fill in) --------------------------
# .env is gitignored (§S2). In k8s these come from Secrets/ConfigMap, not a file.

# Service
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Max JSON body size — oversized-body DoS guard (§S3)
BODY_LIMIT=8kb

# Postgres (persistent store — hard dependency, §O3)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iocheck
# Least-privilege app user (SELECT/INSERT/UPDATE on ioc only, §S2) — NOT a superuser
POSTGRES_USER=iocheck_app
POSTGRES_PASSWORD=change_me
# These are consumed by the Postgres container's init.sh (compose) to CREATE the app
# role from env instead of a committed literal (§S2). Keep == POSTGRES_USER/PASSWORD.
APP_DB_USER=iocheck_app
APP_DB_PASSWORD=change_me
# Superuser for the Postgres container/init (compose only) — distinct from the app role.
POSTGRES_SUPER_PASSWORD=change_me_super
# Per-pod connection pool size — bounds max replicas via DB conn ceiling (§O8)
PG_POOL_MAX=10

# Redis (cache — soft dependency, fail-open, §O3)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me
# Read-through TTLs (seconds)
CACHE_TTL_SECONDS=300
# Negative cache is shorter so a later upsert surfaces quickly even if invalidation is missed
NEGATIVE_CACHE_TTL_SECONDS=60

# Admin auth for POST /ioc (privileged write, §S1). Rotate via Secret in prod.
IOC_ADMIN_API_KEY=change_me_dev_only

# Graceful shutdown (§O2) — preStop sleep is set in the k8s manifest, not here
SHUTDOWN_DRAIN_MS=10000
